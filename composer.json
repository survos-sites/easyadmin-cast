{
    "type": "project",
    "name": "survos-sites/easyadmin-cast",
    "description": "updated version of code for https://symfonycasts.com/screencast/easyadminbundle",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "composer/package-versions-deprecated": "^1.11",
        "doctrine/doctrine-bundle": "^2.1",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "doctrine/orm": "^3.3",
        "easycorp/easyadmin-bundle": "^5.x-dev",
        "handcraftedinthealps/goodby-csv": "^1.4",
        "knplabs/knp-time-bundle": "^2.4",
        "league/commonmark": "^2.6",
        "stof/doctrine-extensions-bundle": "^1.4",
        "survos/core-bundle": "^1.5",
        "symfony/asset-mapper": "^7.2",
        "symfony/console": "^7.1",
        "symfony/dotenv": "^7.1",
        "symfony/flex": "^2.0.0",
        "symfony/framework-bundle": "^7.1",
        "symfony/mime": "^7.1",
        "symfony/monolog-bundle": "^3.0",
        "symfony/runtime": "^7.1",
        "symfony/security-bundle": "^7.1",
        "symfony/stopwatch": "^7.1",
        "symfony/twig-bundle": "^7.1",
        "symfony/ux-autocomplete": "^2.23",
        "symfony/ux-chartjs": "^2.0",
        "symfony/ux-dropzone": "^2.23",
        "symfony/yaml": "^7.1",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/markdown-extra": "^3.20",
        "twig/twig": "^2.12|^3.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.3||^4.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpunit/phpunit": "^12.0",
        "pierstoval/smoke-testing": "^1.2",
        "rector/rector": "^2.0",
        "survos/crawler-bundle": "^1.5",
        "survos/maker-bundle": "^1.5",
        "symfony/debug-bundle": "^7.1",
        "symfony/maker-bundle": "^1.15",
        "symfony/var-dumper": "^7.1",
        "symfony/web-profiler-bundle": "^7.1",
        "zenstruck/browser": "^1.9",
        "zenstruck/foundry": "^2.0"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "platform": {},
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.1"
        }
    }
}
